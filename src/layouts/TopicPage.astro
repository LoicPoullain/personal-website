---
import Hero from "../components/Hero.astro";
import Container from "./Container.astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  showSocialLinks?: boolean;
}

const { title, description, showSocialLinks } = Astro.props;
---

<Layout title={'Loïc Poullain - ' + title} description={description}>
  <Hero
    title={title}
    description={description}
    showSocialLinks={showSocialLinks}
  />
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-16 lg:gap-y-20">
      <slot />
    </div>
  </Container>
</Layout>